{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1StillAnswer/v1",
  "description": "A scene module for one chapter of a continuous diagram, and what it asks the line to fetch or draw first: real maps (OpenStreetMap) and 示意 pictures (text-free generated art). Rules: work/recipe-board-v1/prompts/morph.md. Checked by chapter.mjs before it is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceTaskInputHash",
    "motionImplementation",
    "code",
    "patches",
    "maps",
    "art",
    "glyphs",
    "pages",
    "bakes",
    "hairline"
  ],
  "properties": {
    "motionImplementation": {
      "type": [
        "array",
        "null"
      ],
      "description": "For motionRules contracts, one implementation index per shotId: exact uncommented excerpts of current code. Traceability only, not runtime/semantic proof. Legacy answers may use null. Bound by existing sourceTaskInputHash.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotId",
          "start",
          "change",
          "end",
          "handoff",
          "motionRules"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "minLength": 8
          },
          "change": {
            "type": "string",
            "minLength": 8
          },
          "end": {
            "type": "string",
            "minLength": 8
          },
          "handoff": {
            "type": "string",
            "minLength": 8
          },
          "motionRules": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "sourceTaskInputHash": {
      "type": "string",
      "description": "Copy input.sourceTaskInputHash from the current task; answers for a different task version are rejected."
    },
    "code": {
      "type": "string"
    },
    "patches": {
      "type": "array",
      "description": "revision rounds: exact edits to previousAnswer.code (find must occur once); code is then left empty",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "find",
          "replace"
        ],
        "properties": {
          "find": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          }
        }
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "place",
          "pins",
          "radiusKm"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "place": {
            "type": "string"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "radiusKm": {
            "type": "number"
          }
        }
      }
    },
    "art": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "prompt",
          "transparent",
          "file"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "transparent": {
            "type": "boolean"
          },
          "file": {
            "type": "string",
            "description": "Existing project-relative art file to reuse instead of generating again."
          }
        }
      }
    },
    "glyphs": {
      "description": "a word's outlines from a house font, for letters built in 3D (kit.blockType): data[key]; [] when none",
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "text",
          "face"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "face": {
            "type": "string",
            "description": "a house font family: House Sumikaku, House Kaiso, House Kikai, House Kokka, House Soukou, House Kinkaku"
          }
        }
      }
    },
    "bakes": {
      "type": [
        "array",
        "null"
      ],
      "description": "Offline Blender requests; null preserves previous requests on a patch, [] clears them. Legacy answers may omit this field. rigid → A1RigidBakeRequest/v1 JSON text; prepared data[key] is consumed by kit.engine.baked.rigid(data[key]).",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "request"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rigid"
            ]
          },
          "request": {
            "type": "string"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "description": "pages drawn by the card line's modules and shown in the chapter as moving pictures (images[key], images[key].frame(s)): a captured article with its sentences marked (module article), real prices (market), a chat, a quote; spec is the module's spec as JSON text, checked and rendered by the card renderer (modules.mjs renderModule) with its checks",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "spec"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          }
        }
      }
    },
    "hairline": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "key",
        "figure",
        "phaseMs",
        "intensity"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^hairline_[A-Za-z0-9_]{1,48}$"
        },
        "figure": {
          "const": "exploded"
        },
        "phaseMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Fixed phase, still-only image asset. Not a chapter animation."
    }
  }
}
