{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A1RecipeBoardWorld/v2 (agent answer)",
 "description": "Two or three directions for the film's own world, each derived from its subject by one association and held to the reference films' level (prompts/world.md; routing/world-precedents.json). The user picks one at the look gate.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "directions"
 ],
 "properties": {
  "contract": {
   "type": "string",
   "enum": [
    "A1RecipeBoardWorld/v2"
   ]
  },
  "directions": {
   "type": "array",
   "minItems": 2,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "angle",
     "precedent",
     "learns",
     "differs",
     "subject",
     "ground",
     "main",
     "accent",
     "ink",
     "texture",
     "photo",
     "diagram",
     "props",
     "bgWords",
     "display",
     "art",
     "camera",
     "why",
     "frames"
    ],
    "properties": {
     "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "object",
       "looks",
       "light",
       "medium"
      ],
      "properties": {
       "object": {
        "type": "string",
        "description": "the thing the film is about, as it is in the world (一支香烟和它的烟盒)"
       },
       "looks": {
        "type": "string",
        "description": "what it looks like in reality: its materials, colours, surfaces"
       },
       "light": {
        "type": "string",
        "description": "the light it is seen in (实验室的冷光、夜里、阳光下的牧场)"
       },
       "medium": {
        "type": "string",
        "description": "what people look at it through (检测报告、监护仪、夜视镜、行情屏、旧报纸)"
       }
      }
     },
     "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "tone",
       "color",
       "from"
      ],
      "properties": {
       "tone": {
        "type": "string",
        "enum": [
         "dark",
         "light"
        ]
       },
       "color": {
        "type": "string"
       },
       "from": {
        "type": "string",
        "description": "which of the subject this ground is taken from"
       }
      }
     },
     "main": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "color",
       "from"
      ],
      "properties": {
       "color": {
        "type": "string"
       },
       "from": {
        "type": "string"
       }
      }
     },
     "accent": {
      "type": [
       "object",
       "null"
      ],
      "additionalProperties": false,
      "required": [
       "color",
       "from"
      ],
      "properties": {
       "color": {
        "type": "string"
       },
       "from": {
        "type": "string"
       }
      }
     },
     "ink": {
      "type": "string",
      "description": "the colour of the words on the ground (#RRGGBB)"
     },
     "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "grain",
       "vignette",
       "from"
      ],
      "properties": {
       "grain": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "vignette": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "from": {
        "type": "string"
       }
      }
     },
     "photo": {
      "type": "string",
      "enum": [
       "color",
       "mono",
       "duotone"
      ],
      "description": "how real photographs and footage are treated"
     },
     "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mode",
       "from"
      ],
      "properties": {
       "mode": {
        "type": "string",
        "enum": [
         "line",
         "glass3d",
         "iso3d",
         "illustration",
         "pixel",
         "flat",
         "photo-object"
        ]
       },
       "from": {
        "type": "string"
       }
      }
     },
     "props": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "string",
       "description": "an object of this subject the film shows as a prop (text-free, real or painted)"
      }
     },
     "bgWords": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "string",
       "description": "English words laid faint behind as texture"
      }
     },
     "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "face",
       "x"
      ],
      "properties": {
       "face": {
        "type": "string",
        "enum": [
         "f.k 機械彫刻",
         "スミカク",
         "黒華明朝",
         "金畫字",
         "廻想体 ネクスト"
        ]
       },
       "x": {
        "type": "number",
        "minimum": 0.55,
        "maximum": 1
       }
      }
     },
     "art": {
      "type": "string",
      "description": "how painted plates and props are described to image generation (English, text-free, in the world's light and materials)"
     },
     "camera": {
      "type": "string",
      "enum": [
       "calm",
       "brisk"
      ]
     },
     "why": {
      "type": "string",
      "description": "one paragraph: why this subject makes this world"
     },
     "frames": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "beat",
        "name",
        "spec"
       ],
       "properties": {
        "beat": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "spec": {
         "type": "string",
         "description": "a card module spec as JSON text (module, at, end, and its fields), set in this world (theme is filled in)"
        }
       }
      }
     },
     "id": {
      "type": "string",
      "enum": [
       "A",
       "B",
       "C"
      ]
     },
     "angle": {
      "type": "string",
      "enum": [
       "object",
       "place-era",
       "mood",
       "metaphor",
       "precedent"
      ],
      "description": "which association this direction comes from: the thing itself, its place and era, the mood, the film's one metaphor, a reference episode"
     },
     "precedent": {
      "type": "string",
      "description": "the id of the reference world it learns from (routing/world-precedents.json)"
     },
     "learns": {
      "type": "string",
      "description": "what it takes from that precedent (how it derived its world, the devices it showed facts with)"
     },
     "differs": {
      "type": "string",
      "description": "how this film's world differs from it, and why the subject asks for that"
     }
    }
   }
  }
 }
}
