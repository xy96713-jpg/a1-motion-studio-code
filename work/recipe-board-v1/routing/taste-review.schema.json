{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A1TasteReview/v1 (blind reviewer answer)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "beats",
  "overall",
  "maturity"
 ],
 "properties": {
  "maturity": {
  "type": ["object", "null"],
  "additionalProperties": false,
  "required": [
    "scope",
    "inspected",
    "wholeFilmCoherence",
    "observation",
    "beats"
  ],
  "properties": {
    "scope": {
      "const": "whole-film-stills"
    },
    "inspected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "original-size",
          "downscaled",
          "whole-board"
        ]
      },
      "minItems": 3
    },
    "wholeFilmCoherence": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat",
          "clarity",
          "compositionHierarchy",
          "imageTextIntegration",
          "materialSubjectCredibility",
          "wholeFilmCoherence",
          "observation"
        ],
        "properties": {
          "beat": {
            "type": "string"
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "clarity": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "compositionHierarchy": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "imageTextIntegration": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "materialSubjectCredibility": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "wholeFilmCoherence": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    }
  }
},
  "overall": {
   "type": "string"
  },
  "beats": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "beat",
     "composition",
     "figureGround",
     "focus",
     "ground",
     "type",
     "score",
     "issue",
     "toFour",
     "checked",
     "hard"
    ],
    "properties": {
     "beat": {
      "type": "string"
     },
     "composition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "figureGround": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "focus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "ground": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "type": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "issue": {
      "type": [
       "string",
       "null"
      ]
     },
     "toFour": {
      "type": "array",
      "maxItems": 3,
      "items": {
       "type": "string"
      }
     },
     "checked": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "item",
        "done",
        "why"
       ],
       "properties": {
        "item": {
         "type": "integer",
         "minimum": 1
        },
        "done": {
         "type": "boolean"
        },
        "why": {
         "type": "string"
        }
       }
      }
     },
     "hard": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
